# This file is the contract for TWO runtimes, not one.
#
#   Vercel      runs the Next.js app: pages, server actions, API routes.
#   Trigger.dev runs every background job in trigger/jobs/ on its own servers.
#
# Trigger.dev jobs cannot see Vercel's environment variables. Anything a job
# reads must be set separately in the Trigger.dev dashboard, per environment.
# Setting a variable in Vercel alone means the job fails at runtime with a
# "not configured" error, and because jobs run after the webhook has already
# returned 200, nothing in the Vercel logs will look wrong.
#
# Variables marked [BOTH] below are read from job code (directly or through
# lib/) and must exist in Vercel AND Trigger.dev. Cost a full afternoon on
# 2026-08-04 when inbound WhatsApp had the Meta credentials in Vercel only.
#
# Vercel only: STRIPE_*, RESEND_WEBHOOK_SECRET, WHATSAPP_VERIFY_TOKEN,
# META_APP_SECRET, CRON_SECRET, NEXT_PUBLIC_GOOGLE_MAPS_API_KEY,
# TRIGGER_SECRET_KEY (it is the key used to reach Trigger.dev, so the jobs
# themselves never need it).

# App
NEXT_PUBLIC_APP_URL=            # [BOTH] links inside outbound messages

# Supabase
NEXT_PUBLIC_SUPABASE_URL=       # [BOTH] admin client in every job
NEXT_PUBLIC_SUPABASE_ANON_KEY=  # [BOTH] admin client in every job
SUPABASE_SERVICE_ROLE_KEY=      # [BOTH] admin client in every job

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# AI
ANTHROPIC_API_KEY=              # [BOTH] crew Q&A, forward extraction

# Trigger.dev
TRIGGER_SECRET_KEY=
TRIGGER_API_URL=

# Email
RESEND_API_KEY=                 # [BOTH] outbound email from jobs
RESEND_WEBHOOK_SECRET=
# [BOTH] per-tour sending domain. Comment kept on its own line: this is the one
# variable here that ships with a value, and a trailing comment after a value
# can end up inside the value depending on the dotenv parser.
EMAIL_ROOT_DOMAIN=tourwithreeve.com

# WhatsApp
WHATSAPP_CLOUD_API_TOKEN=       # [BOTH] every outbound WhatsApp send
WHATSAPP_PHONE_NUMBER_ID=       # [BOTH] every outbound WhatsApp send
WHATSAPP_VERIFY_TOKEN=
# One Meta app, one secret. Read by both the WhatsApp inbound webhook and the
# Meta data-deletion callback. Do not add a second name for it.
META_APP_SECRET=

# WhatsApp templates (Meta Business Manager approval required per template)
WHATSAPP_TEMPLATE_BOARDING_PASS=              # [BOTH]
WHATSAPP_TEMPLATE_BROADCAST=                  # [BOTH]
WHATSAPP_TEMPLATE_OPENER=                     # [BOTH]
WHATSAPP_TEMPLATE_SHOW_INFO_FULL=             # [BOTH]
WHATSAPP_TEMPLATE_SHOW_INFO_NO_SOUNDCHECK=    # [BOTH]
WHATSAPP_TEMPLATE_SHOW_INFO_NO_CHANGEOVER=    # [BOTH]
WHATSAPP_TEMPLATE_SHOW_INFO_MINIMAL=          # [BOTH]
WHATSAPP_TEMPLATE_CATERING_FULL=              # [BOTH]
WHATSAPP_TEMPLATE_CATERING_NO_BREAKFAST=      # [BOTH]
WHATSAPP_TEMPLATE_CATERING_BUYOUT=            # [BOTH]
WHATSAPP_TEMPLATE_WRAP_TRAVEL=                # [BOTH]
WHATSAPP_TEMPLATE_WRAP_STATIC=                # [BOTH]

# Telegram
TELEGRAM_BOT_TOKEN=             # [BOTH] outbound Telegram send
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=          # [BOTH] deep links in messages

# Travel providers
DUFFEL_API_TOKEN=               # [BOTH] planner adapters
TRAINLINE_PARTNER_TOKEN=        # [BOTH] planner adapters
SNCF_API_TOKEN=                 # [BOTH] planner adapters
RENFE_API_TOKEN=                # [BOTH] planner adapters

# Maps
GOOGLE_MAPS_API_KEY=            # [BOTH] hub resolution job
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Hotels
RATEHAWK_API_KEY=               # [BOTH] hotel adapters
ENABLE_MOCK_HOTELS=             # [BOTH] hotel adapters

# Flight tracking
AIRLABS_API_KEY=                # [BOTH] flight status polling job

# Redis
UPSTASH_REDIS_REST_URL=         # [BOTH] send idempotency claims in jobs
UPSTASH_REDIS_REST_TOKEN=       # [BOTH] send idempotency claims in jobs

# Cron
CRON_SECRET=

# Cloudflare
CLOUDFLARE_API_TOKEN=           # [BOTH] domain provisioning job
CLOUDFLARE_ZONE_ID=             # [BOTH] domain provisioning job
